  },
  "license": "MIT",
  "author": "laizer334",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "npm i && (test -f gateway/src/index.ts || npm run build) && node --env-file=.env --experimental-strip-types gateway/src/index.ts",
    "build": "node --env-file=.env --experimental-strip-types scripts/builds/buildAll.ts",
    "dev": "node --env-file=.env --experimental-strip-types gateway/src/index.ts",
    "examples": "node  --env-file=.env --experimental-strip-types examples/runner.ts"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@xterm/headless": "^6.0.0",
    "fastify": "^5.8.5",
    "openai": "^6.34.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "archiver": "^7.0.1"
  }
}
